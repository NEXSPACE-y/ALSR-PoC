+
+static bool ggml_backend_sched_alsr_prepared_copy(
+        ggml_backend_sched_t sched,
+        int split_id,
+        int input_id,
+        struct ggml_tensor * input,
+        struct ggml_tensor * input_cpy,
+        ggml_backend_t input_backend,
+        ggml_backend_t split_backend) {
+    if (sched->callback_alsr == NULL) {
+        return false;
+    }
+
+    const size_t total = ggml_nbytes(input);
+    size_t offset = 0;
+    bool prepared_path_selected = false;
+    while (offset < total) {
+        ggml_backend_sched_alsr_event_data request = {
+            /* .event               = */ GGML_BACKEND_SCHED_ALSR_RANGE_REQUEST,
+            /* .graph_uid           = */ sched->alsr_graph_uid,
+            /* .split_id            = */ split_id,
+            /* .node_index          = */ -1,
+            /* .input_index         = */ input_id,
+            /* .copy_id             = */ sched->cur_copy,
+            /* .node                = */ NULL,
+            /* .source              = */ input,
+            /* .destination         = */ input_cpy,
+            /* .source_backend      = */ input_backend,
+            /* .destination_backend = */ split_backend,
+            /* .completion_event    = */ NULL,
+            /* .source_is_weight    = */ true,
+            /* .requested_source_offset = */ offset,
+            /* .requested_source_bytes  = */ total - offset,
+            /* .prepared_data           = */ NULL,
+            /* .prepared_bytes          = */ 0,
+            /* .prepared_slot_id        = */ 0,
+            /* .prepared_slot_generation = */ 0,
+            /* .prepared_data_valid     = */ false,
+        };
+        if (!sched->callback_alsr(&request, sched->callback_alsr_user_data)) {
+            sched->alsr_abort = true;
+            return false;
+        }
+        if (!request.prepared_data_valid) {
+            if (prepared_path_selected) {
+                sched->alsr_abort = true;
+            }
+            return false;
+        }
+        prepared_path_selected = true;
+        if (request.prepared_data == NULL || request.prepared_bytes == 0 ||
+            request.prepared_bytes > total - offset) {
+            sched->alsr_abort = true;
+            return false;
+        }
+
+        // Synchronous host-buffer set makes the source lifetime explicit: on
+        // return the prepared Ring bytes are no longer referenced. This does
+        // not synchronize unrelated graph compute as a backend-wide barrier
+        // would. CUDA can later replace this boundary with a per-range event.
+        ggml_backend_tensor_set(input_cpy, request.prepared_data,
+                offset, request.prepared_bytes);
+
+        request.event = GGML_BACKEND_SCHED_ALSR_RANGE_COMMITTED;
+        request.requested_source_offset = offset;
+        request.requested_source_bytes = request.prepared_bytes;
+        if (!sched->callback_alsr(&request, sched->callback_alsr_user_data)) {
+            sched->alsr_abort = true;
+            return false;
+        }
+        offset += request.prepared_bytes;
+    }
+    return prepared_path_selected;
+}
